# =============================================================================
# PDG_RAG — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Weaviate ---
WEAVIATE_URL=http://localhost:8080

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_BATCH_SIZE=32
# Options: cuda, cpu — leave as "cuda" and it auto-falls back to cpu if unavailable
EMBEDDING_DEVICE=cuda

# --- Chunking ---
PARENT_CHUNK_SIZE=1024
CHILD_CHUNK_SIZE=256
CHUNK_OVERLAP=51

# --- Enrichment ---
MAX_KEYWORDS=10

# --- Storage ---
UPLOAD_DIR=data/uploads
DB_URL=sqlite:///./data/pdg_rag.db

# --- Celery Queues ---
CELERY_HIGH_PRIORITY_QUEUE=high_priority
CELERY_BATCH_QUEUE=batch

# --- File Limits ---
MAX_FILE_SIZE_MB=100

# --- Weaviate Batching ---
WEAVIATE_BATCH_SIZE=100

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
